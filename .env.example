# Application
NODE_ENV=production
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-postgres-password
DB_NAME=wageringdb

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-access-secret-key
AWS_ENDPOINT=http://localstack:4566

# LocalStack
LOCALSTACK_AUTH_TOKEN=your-token