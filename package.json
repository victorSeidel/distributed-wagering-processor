{
    "name": "distributed-wagering-processor",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/main.ts",
        "start": "bun src/main.ts",
        "build": "bun build ./src/main.ts --outdir ./dist --target node",
        "test": "bun test tests/unit",
        "test:integration": "bun test tests/integration",
        "test:concurrency": "bun test tests/concurrency",
        "test:load": "bun test tests/load",
        "infra:up": "docker compose up -d",
        "infra:down": "docker compose down -v",
        "migration:create": "bunx --bun mikro-orm migration:create",
        "migration:up": "bunx --bun mikro-orm migration:up",
        "migration:down": "bunx --bun mikro-orm migration:down"
    },
    "devDependencies": {
        "@mikro-orm/cli": "^7.2.5",
        "@nestjs/cli": "^12.0.8",
        "@nestjs/testing": "^12.1.3",
        "@types/bun": "latest",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/uuid": "^11.0.0",
        "tsx": "^4.23.15"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@aws-sdk/client-sqs": "^3.1151.0",
        "@mikro-orm/core": "^7.2.5",
        "@mikro-orm/migrations": "^7.2.5",
        "@mikro-orm/nestjs": "^7.1.0",
        "@mikro-orm/postgresql": "^7.2.5",
        "@nestjs/common": "^12.1.3",
        "@nestjs/core": "^12.1.3",
        "@nestjs/platform-express": "^12.1.3",
        "decimal.js": "^10.6.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "uuid": "^14.0.3"
    }
}
